generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  name           String
  password       String
  createdAt      DateTime  @default(now())
  role           Role      @default(USER)
  isActive       Boolean   @default(true)
  comments       Comment[]
  likes          Like[]
  posts          Post[]
  stories        Story[]
  avatar         Avatar?
  reportsFiled   Report[]  @relation("ReportReporter")
  reportsHandled Report[]  @relation("ReportHandler")
  save Saved[]

  friendshipsInitiated Friendship[]    @relation("UserFriendships")
  friendshipsReceived Friendship[]    @relation("FriendFriendships")
  sentFriendRequests  FriendRequest[] @relation("sentFriendRequest")
  receivedFriendRequests FriendRequest[] @relation("receivedFriendRequest")
}

model Avatar {
  id     String  @id @default(uuid())
  avatar String?

  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model Friendship {
  id         String   @id @default(uuid())
  userId     String
  friendId   String
  createdAt  DateTime @default(now())
  

  user       User     @relation("UserFriendships", fields: [userId], references: [id], onDelete: Cascade)
  friend     User     @relation("FriendFriendships", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
}

model FriendRequest {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  createdAt  DateTime @default(now())
  status Friendstatus @default(PENDING)

  sender   User @relation("sentFriendRequest", fields: [senderId], references: [id])
  receiver User @relation("receivedFriendRequest", fields: [receiverId], references: [id])

  @@unique([senderId, receiverId])
}


model Saved {
    id     String  @id @default(uuid())
    postID String
    userID String
    createAt DateTime @default(now())

    user User @relation(fields: [userID], references: [id] , onDelete: Cascade)
    post Post @relation(fields: [postID], references: [id], onDelete: Cascade)

    @@unique([postID , userID])
}

model Story {
  id        String   @id @default(uuid())
  content   String?
  image     String?
  authorId  String
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id] , onDelete: Cascade)
}

model Post {
  id        String  @id @default(uuid())
  content   String?
  image     String?
  mediaType String  @default("image")
  published Boolean @default(false)
  authorId  String

  createdAt DateTime  @default(now())
  comments  Comment[]
  likes     Like[]
  author    User      @relation(fields: [authorId], references: [id])
  save Saved[]
  media     PostMedia[]
}

model PostMedia {
  id        String   @id @default(uuid())
  url       String
  mediaType String
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  postId    String
  authorId  String
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id])
  post      Post     @relation(fields: [postId], references: [id])
}

model Like {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}

model Report {
  id            String           @id @default(uuid())
  type          String
  reason        String
  attachmentUrl String?
  targetType    ReportTargetType @default(PLATFORM)
  targetId      String?
  status        ReportStatus     @default(OPEN)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  reporterId    String
  handledById   String?
  reporter      User             @relation("ReportReporter", fields: [reporterId], references: [id])
  handledBy     User?            @relation("ReportHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
}



enum ReportTargetType {
  PLATFORM
  USER
  POST
  COMMENT
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

enum Role {
  USER
  ADMIN
}

enum Friendstatus {
  PENDING
  ACCEPTED
  REJECTED
}
