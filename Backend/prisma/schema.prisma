generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  name           String
  password       String
  createdAt      DateTime  @default(now())
  role           Role      @default(USER)
  isActive       Boolean   @default(true)
  comments       Comment[]
  likes          Like[]
  posts          Post[]
  stories        Story[]
  avatar         Avatar?
  reportsFiled   Report[]  @relation("ReportReporter")
  reportsHandled Report[]  @relation("ReportHandler")
}

model Avatar {
  id     String  @id @default(uuid())
  avatar String?

  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id])
}

model Story {
  id        String   @id @default(uuid())
  content   String?
  image     String?
  authorId  String
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id])
}

model Post {
  id        String  @id @default(uuid())
  content   String?
  image     String?
  published Boolean @default(false)
  authorId  String

  createdAt DateTime  @default(now())
  comments  Comment[]
  likes     Like[]
  author    User      @relation(fields: [authorId], references: [id])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  postId    String
  authorId  String
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id])
  post      Post     @relation(fields: [postId], references: [id])
}

model Like {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}

model Report {
  id            String           @id @default(uuid())
  type          String
  reason        String
  attachmentUrl String?
  targetType    ReportTargetType @default(PLATFORM)
  targetId      String?
  status        ReportStatus     @default(OPEN)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  reporterId    String
  handledById   String?
  reporter      User             @relation("ReportReporter", fields: [reporterId], references: [id])
  handledBy     User?            @relation("ReportHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

enum ReportTargetType {
  PLATFORM
  USER
  POST
  COMMENT
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

enum Role {
  USER
  ADMIN
}
